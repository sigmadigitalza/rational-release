{
  "name": "@sigmadigitalza/rational-release",
  "version": "1.6.0",
  "license": "MIT",
  "exports": {
    ".": "./cli/mod.ts",
    "./lib": "./cli/lib.ts"
  },
  "publish": {
    "include": [
      "cli/",
      "README.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "cli/*_test.ts"
    ]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-run --allow-env cli/",
    "lint": "deno lint cli/",
    "check": "deno check cli/mod.ts cli/lib.ts",
    "fmt": "deno fmt --check cli/",
    "ci": "deno task fmt && deno task lint && deno task check && deno task test"
  },
  "lint": {
    "include": [
      "cli/"
    ]
  },
  "fmt": {
    "include": [
      "cli/"
    ]
  }
}
